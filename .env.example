# Puerto de la aplicación (desplazado +14 para evitar colisiones: 3014)
PORT=3014
NODE_ENV=production

# URL pública base del servicio (usada para generar los enlaces para correos)
APP_URL=https://drive.sekaitech.com.pe

# Conexión a PostgreSQL (dokploy provee esta cadena automáticamente o usa el servicio postgres de docker-compose)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5446/drive_billonmail

# Límite máximo de subida para archivos pesados (en MB)
MAX_FILE_SIZE_MB=2048

# Días por defecto de retención para archivos temporales
DEFAULT_RETENTION_DAYS=15
